# =============================================================================
# POLYMARKET WEATHER OBSERVER - ENVIRONMENT CONFIGURATION
# =============================================================================
#
# INSTRUCTIONS:
# 1. Copy this file to .env (gitignored — never commit .env!)
# 2. Fill in your credentials
# 3. Start with paper trading (LIVE_TRADING_ENABLED=false)
# 4. Only flip to "true" after verifying paper WR > 60% over 50+ trades
#
# =============================================================================

# -----------------------------------------------------------------------------
# POLYMARKET CREDENTIALS — AUTH MODE 1: L2 (Empfohlen, kein Private-Key noetig)
# -----------------------------------------------------------------------------
#
# HOW TO GET L2 CREDENTIALS:
# 1. Gehe zu polymarket.com und logge dich ein
# 2. Öffne Browser Developer Tools → Application → Local Storage
# 3. Such nach "polymarket" → kopiere api-key, api-secret, passphrase
# OR: https://docs.polymarket.com/developers/api/authentication
#
# L2 is the preferred auth method — no private key needed, less risk.
#
POLYMARKET_API_KEY=
POLYMARKET_API_SECRET=
POLYMARKET_PASSPHRASE=
POLYMARKET_WALLET_ADDRESS=0xYourProxyWalletAddress

# -----------------------------------------------------------------------------
# POLYMARKET CREDENTIALS — AUTH MODE 2: L1 (Private Key — weniger sicher)
# -----------------------------------------------------------------------------
#
# Nur noetig wenn L2 nicht vorhanden. Automatisch abgeleitet aus Private Key.
# WARNUNG: Private Key NIE in git committen!
#
# POLYMARKET_PRIVATE_KEY=0xYourPrivateKeyHere

# -----------------------------------------------------------------------------
# LIVE TRADING GATE — Sicherheitsschalter
# -----------------------------------------------------------------------------
#
# WICHTIG: Auf "true" setzen NUR wenn bereit fuer echtes Trading!
# Checkliste vor Aktivierung:
#   [ ] Paper WR > 60% über mindestens 50 Trades nachgewiesen
#   [ ] USDC.e auf dem Proxy-Wallet vorhanden (mind. 500 EUR Äquivalent)
#   [ ] Telegram-Benachrichtigungen konfiguriert (jeder Trade sendet Alert)
#   [ ] Risiko verstanden: max. Verlust pro Trade = Position-Size EUR
#
LIVE_TRADING_ENABLED=false

# -----------------------------------------------------------------------------
# WEATHER FORECAST API KEYS (mind. 2 nötig für Ensemble-Signals!)
# -----------------------------------------------------------------------------

# Tomorrow.io — kostenloses Tier: 500 Calls/Tag
# Anmelden: https://www.tomorrow.io/
TOMORROW_IO_API_KEY=

# OpenWeather — kostenloses Tier: 1000 Calls/Tag
# Anmelden: https://openweathermap.org/api
OPENWEATHER_API_KEY=

# WeatherAPI.com — kostenloses Tier: 1000 Calls/Tag
# Anmelden: https://www.weatherapi.com/
WEATHERAPI_KEY=

# Open-Meteo: KEIN API Key nötig (komplett kostenlos, GFS-Modell)
# MET Norway Yr: KEIN API Key nötig (komplett kostenlos)

# -----------------------------------------------------------------------------
# TELEGRAM — Trade-Alerts & Approval-Flow
# -----------------------------------------------------------------------------
#
# Nötig für: Stop-Loss Alerts, High-Edge Signale, Live-Trade-Genehmigung
# Setup: BotFather → /newbot → Token und Chat-ID eintragen
#
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# -----------------------------------------------------------------------------
# ANTHROPIC API — LLM Trade-Reasoning (optional)
# -----------------------------------------------------------------------------
#
# Aktiviert GPT-Sanity-Check vor jedem Trade-Entry (~$0.001/Trade)
# Ohne diesen Key läuft der Bot normal (LLM-Check wird übersprungen)
#
# ANTHROPIC_API_KEY=sk-ant-...

# -----------------------------------------------------------------------------
# PARAMETER OVERRIDES (optional)
# -----------------------------------------------------------------------------
# MAX_POSITION_SIZE_EUR=100
# MAX_OPEN_POSITIONS=10
